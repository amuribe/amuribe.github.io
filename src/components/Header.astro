---
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV } from '../site';
import { hasPosts } from '../lib/content';

// Writing stays out of the nav until the first post is published
const showWriting = await hasPosts();
const nav = NAV.filter((item) => item.href !== '/writing/' || showWriting);

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <Wordmark />
  <nav aria-label="Main">
    <ul>
      {
        nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
      <li><ThemeToggle /></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-m) var(--space-xs);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3xs) var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    margin-top: 0;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
    font-variant-caps: all-small-caps;
    letter-spacing: var(--meta-tracking);
    font-size: 1.1em;
  }
  nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
</style>
