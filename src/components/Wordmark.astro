---
/**
 * Text wordmark. Placeholder until Alex's custom logo exists:
 * swap the contents of this one file and the logo appears everywhere.
 */
import { SITE } from '../site';
---

<a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>{SITE.name}</a>

<style>
  .wordmark {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .wordmark:hover {
    color: var(--accent);
  }
</style>
