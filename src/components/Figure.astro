---
/**
 * A numbered figure with an image (screenshot, photo, diagram).
 * Images are optimised at build time (resized, converted to WebP).
 *
 *   import shot from './amuvie/browse.png';
 *   <Figure src={shot} alt="…" caption="…" />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** What the image shows, for screen readers. */
  alt: string;
  caption: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="figure image-figure">
  <a href={src.src} class="frame" aria-label={`Open full-size image: ${alt}`}>
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280, 1620]}
      sizes="(min-width: 60rem) 54rem, 100vw"
      format="webp"
      quality={80}
    />
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .frame {
    display: block;
    border: var(--rule-width) solid var(--rule);
  }
  .frame:hover {
    border-color: var(--accent);
  }
  img {
    width: 100%;
    height: auto;
  }
</style>
