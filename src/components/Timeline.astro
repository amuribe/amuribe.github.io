---
/** CV-style list: dates on the left, role and details on the right. */
interface Item {
  dates: string;
  title: string;
  org: string;
  details?: string[];
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ol class="timeline">
  {
    items.map(({ dates, title, org, details }) => (
      <li>
        <p class="dates meta">{dates}</p>
        <div class="body">
          <h3>{title}</h3>
          <p class="org">{org}</p>
          {details && details.length > 0 && (
            <ul>
              {details.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-s);
  }
  .timeline > li + li {
    margin-top: var(--space-m);
  }
  .dates {
    margin: 0;
    font-variant-numeric: lining-nums tabular-nums;
    padding-top: 0.1em;
  }
  h3 {
    font-size: var(--step-0);
    margin: 0;
  }
  .org {
    font-style: italic;
    color: var(--muted);
    margin: 0 0 var(--space-2xs);
  }
  ul {
    margin: 0;
  }
  @media (max-width: 36rem) {
    .timeline > li {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
  }
</style>
