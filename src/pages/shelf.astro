---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Citation from '../components/Citation.astro';

const sections = [
  { medium: 'book', heading: 'Books' },
  { medium: 'film', heading: 'Films' },
  { medium: 'music', heading: 'Music' },
] as const;

const all = await getCollection('shelf');
// Alphabetical by creator, ignoring a leading "The", like a bibliography.
const sortKey = (s: string) => s.replace(/^the\s+/i, '').toLowerCase();
const byMedium = (m: string) =>
  all
    .filter((e) => e.data.medium === m)
    .sort((a, b) => sortKey(a.data.creator).localeCompare(sortKey(b.data.creator)));
---

<Base title="Shelf" description="Books, films, and music Alex McPherson Uribe keeps coming back to.">
  <article class="shelf">
    <header>
      <h1>Shelf</h1>
      <p class="dek">Books, films, and music I keep coming back to.</p>
    </header>

    {
      sections.map(({ medium, heading }) => {
        const entries = byMedium(medium);
        return (
          entries.length > 0 && (
            <section aria-labelledby={medium}>
              <h2 id={medium} class="label">{heading}</h2>
              <ul class="bibliography">
                {entries.map((entry) => (
                  <Citation entry={entry} />
                ))}
              </ul>
            </section>
          )
        );
      })
    }
  </article>
</Base>

<style>
  .shelf {
    max-width: var(--measure);
  }
  h1 {
    margin-bottom: var(--space-2xs);
  }
  .dek {
    font-style: italic;
    color: var(--muted);
    margin-bottom: var(--space-xl);
  }
  section + section {
    margin-top: var(--space-xl);
  }
  h2 {
    font-size: var(--step-1);
    font-weight: 400;
    padding-bottom: var(--space-2xs);
    margin-bottom: var(--space-s);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .bibliography {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
