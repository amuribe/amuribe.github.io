---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/dates';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, summary, date, tags } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={summary}>
  <article class="post">
    <header>
      <p class="kicker label"><a href="/writing/">Writing</a></p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {tags.length > 0 && <><span aria-hidden="true"> · </span>{tags.join(', ')}</>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post header {
    max-width: var(--measure);
    margin-bottom: var(--space-xl);
  }
  .kicker {
    margin-bottom: var(--space-2xs);
  }
  .kicker a {
    color: inherit;
    text-decoration: none;
  }
  .kicker a:hover {
    text-decoration: underline;
  }
  h1 {
    margin-bottom: var(--space-xs);
  }
</style>
